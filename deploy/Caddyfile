# Replace FYNLO_SITE with your address, such as 203.0.113.10.sslip.io.
# Access logs stay off, so tokens and paths with personal data aren't written to disk.
FYNLO_SITE {
	encode gzip

	request_body {
		# Slightly above the API's own 10 MB limit, so the API gives the clear error.
		max_size 11MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /v1/* {
		reverse_proxy 127.0.0.1:4000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
