# Copy this file to .env and fill in your own values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development

# Web app origin allowed by CORS
CORS_ORIGIN=http://localhost:3000

# Supabase: Connect > Session pooler connection string
# URL-encode special characters in the password
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
DB_SCHEMA=fynlo

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
